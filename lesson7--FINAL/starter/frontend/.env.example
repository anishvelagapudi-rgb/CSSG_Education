# Copy this file to .env and fill in the values.
# Anything starting with VITE_ is bundled into the browser - never put secrets here!

VITE_API_URL=http://localhost:3000

# Supabase dashboard -> Project Settings -> API Keys.
# The PUBLISHABLE key only. It is safe in the browser because every table has RLS on.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
