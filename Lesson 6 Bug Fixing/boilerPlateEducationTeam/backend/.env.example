# Copy this file to .env and fill in the values. Never commit .env!

PORT=3000

# Supabase dashboard -> Project Settings -> API Keys
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-secret-key
SUPABASE_SECRET_KEY=ssb_secret_your-secret-key
SUPABASE_JWKS_URL=https://some-id/supabase.co/auth/v1/.well-known/jwks.json

# Allowed frontend origins, comma-separated (add your Vercel URL when deployed)
CORS_ORIGIN=http://localhost:5173